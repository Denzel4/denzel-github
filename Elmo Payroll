# ---  Leave Balances ---
def get_leave_balances():
    print("Fetching leave balances for all employees...")

    # Get employee details
    employee_details = fetch_api_data(f"{BASE_URL}/employee/details")
    df1 = pd.DataFrame(employee_details)
    # Normalize col names to lowercase
    df1.columns = df1.columns.str.lower()

    #  required fields
    cols = [
        "id","title","firstname","preferredname","middlename","surname","gender",
        "dateofbirth","anniversarydate","externalid","emailaddress","startdate","enddate"
    ]

    print(f"Employees Details: {len(df1)} records")

    save_to_civis(df1, "payroll_employees_details")

    # Normalize keys to lowercase 
    employee_details = [
        {k.lower(): v for k, v in record.items()} 
        for record in employee_details
    ]

    # safely extract employeeid
    employee_ids = list({r["id"] for r in employee_details if "id" in r})

    print(f"Found {len(employee_ids)} unique employees with leave requests")

    all_balances = []

    for emp_id in employee_ids:
        url = f"{BASE_URL}/employee/{emp_id}/leavebalances"
        balances = fetch_api_data(url)

        # Normalize returned balances 
        balances = [{k.lower(): v for k, v in b.items()} for b in balances]

        for b in balances:
            b["employeeid"] = emp_id

        all_balances.extend(balances)
        time.sleep(0.2)  # Avoid rate limit

    if not all_balances:
        print("No leave balances found.")
        return pd.DataFrame()

    df = pd.DataFrame(all_balances)
    df.columns = df.columns.str.lower()

    print(f"Leave Balances: {len(df)} records for {len(employee_ids)} employees")
    save_to_civis(df, "payroll_leave_balances")

    return df


