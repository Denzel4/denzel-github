drop_tables()
# --- Fetch Helper ---
def fetch_api_data(endpoint):
    """Fetch JSON from a KeyPay API endpoint with graceful error handling."""
    try:
        response = requests.get(endpoint, auth=AUTH)
        response.raise_for_status()
        data = response.json()
        return data.get("data", data) if isinstance(data, dict) else data
    except Exception as e:
        print(f" Error fetching {endpoint}: {e}")
        return []

# --- Save Function ---
def save_to_civis(df, table_name):
    """Lowercase all columns and save to Civis."""
    if df.empty:
        print(f" No data to save for {table_name}")
        return
    df.columns = df.columns.str.lower()
    try:
        civis.io.dataframe_to_civis(
            df,
            database=CIVIS_DB,
            table=f"{SCHEMA}.{table_name}",
            existing_table_rows="truncate"   
        )
        print(f" Saved {len(df)} records to Civis table: {SCHEMA}.{table_name}")
    except Exception as e:
        print(f" Error saving {table_name} to Civis: {e}")

# --- Employees ---
def get_employees():
    url = f"{BASE_URL}/employee/unstructured"
    cols = [
        "employingentityabn","employingentityid","previoussurname","australianresident",
        "hasapprovedworkingholidayvisa","workingholidayvisacountry","workingholidayvisastartdate",
        "isseasonalworker","employmenttype","terminationreason","gender","anniversarydate","tags",
        "jobtitle","leavetemplate","rosteringnotificationchoices","leaveaccrualstartdatetype",
        "leaveyearstart","id","title","firstname","middlename","surname","preferredname",
        "dateofbirth","residentialcountry","startdate","enddate","hoursperweek","worktypes",
        "status","datecreated","reportingdimensionvalues"
    ]
    data = fetch_api_data(url)
    df = pd.DataFrame(data)
    df.columns = df.columns.str.lower()
    df = df[[c for c in cols if c in df.columns]]
    print(f" Employees: {len(df)} records")
    save_to_civis(df, "payroll_employees")
    return df

